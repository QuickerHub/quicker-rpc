<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>QuickerRpc.Runtime.Test</RootNamespace>
    <IncludeV2HostTests Condition="'$(IncludeV2HostTests)' == ''">true</IncludeV2HostTests>
    <QkrpcV2PrivateDependencies>false</QkrpcV2PrivateDependencies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" VersionOverride="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickerRpc.Runtime\QuickerRpc.Runtime.csproj" />
    <ProjectReference Include="..\..\src\QuickerRpc.Host.Abstractions\QuickerRpc.Host.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\QuickerRpc.Plugin.V2\QuickerRpc.Plugin.V2.csproj" Condition="'$(IncludeV2HostTests)' == 'true'">
      <!-- This test assembly also directly references the neutral Runtime/Contracts graph. -->
      <AdditionalProperties>QkrpcV2PrivateDependencies=false;PrivateAssemblyVersionSuffix=</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeV2HostTests)' != 'true'">
    <Compile Remove="PluginV2CompositionTests.cs;V2CatalogSearchTests.cs;QuickerV2HostProbeTests.cs;QuickerV2SavePathProbeTests.cs;QuickerV2SyncTypeProbeTests.cs;V2CompiledActionSourceTests.cs;V2DesignerReadPrimitivesTests.cs;V2DesignerReadCatalogTests.cs;V2StepRunnerInputContractTests.cs" />
    <!-- Exercise the actual reflection save guard offline without loading a Quicker host assembly. -->
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2ActionAccessor.cs" Link="OfflineV2\QuickerV2ActionAccessor.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2Reflection.cs" Link="OfflineV2\QuickerV2Reflection.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2StepRunnerMapper.cs" Link="OfflineV2\QuickerV2StepRunnerMapper.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2StepRunnerCatalogBuilder.cs" Link="OfflineV2\QuickerV2StepRunnerCatalogBuilder.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2Runtime.cs" Link="OfflineV2\QuickerV2Runtime.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2TypeNames.cs" Link="OfflineV2\QuickerV2TypeNames.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2OperationPayloadWriter.cs" Link="OfflineV2\QuickerV2OperationPayloadWriter.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2CloudSyncTrigger.cs" Link="OfflineV2\QuickerV2CloudSyncTrigger.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Reflection\QuickerV2SourceStorage.cs" Link="OfflineV2\QuickerV2SourceStorage.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V2\Services\V2ActionProgramSourceService.cs" Link="OfflineV2\V2ActionProgramSourceService.cs" />
    <Compile Include="..\..\src\QuickerRpc.Plugin.V1\Services\NativeActionProgramSourceBody.cs" Link="OfflineV2\NativeActionProgramSourceBody.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Quicker.ExpressionEngine" Condition="Exists('..\..\..\..\quicker-host\net10\Quicker.ExpressionEngine.dll')">
      <HintPath>..\..\..\..\quicker-host\net10\Quicker.ExpressionEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Quicker.Common" Condition="Exists('..\..\..\..\quicker-host\net10\Quicker.Common.dll')">
      <HintPath>..\..\..\..\quicker-host\net10\Quicker.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Quicker.Public.Abstractions" Condition="Exists('..\..\..\..\quicker-host\net10\Quicker.Public.Abstractions.dll')">
      <HintPath>..\..\..\..\quicker-host\net10\Quicker.Public.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
